# =================================================================
# AegisResponse — Environment Variables Configuration Template
# =================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:3000

# Datastore Layer (MongoDB Atlas or Local MongoDB)
# Note: If MONGODB_URI is omitted, the system seamlessly runs on in-memory collections!
MONGODB_URI=mongodb://localhost:27017/smart_ambulance

# AI / ML Microservice Endpoint (FastAPI Python Service)
# Note: If offline, Node.js automatically fails over to built-in Manchester Triage rules!
AI_SERVICE_URL=http://localhost:8000

# Geographic Routing & OSRM Routing Engine
OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=your_optional_google_maps_api_key_here

# Outbound SMS & Cellular Fallback Gateway (Twilio)
# Note: If omitted, the platform outputs high-fidelity simulation alerts in console & audit logs.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18005550199

# NLP Triage & LLM Integration (Optional OpenAI / Anthropic)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Security & Session Token
JWT_SECRET=aegis_emergency_jwt_secret_token_key_2026
